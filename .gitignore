# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.env
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local install log (regenerated by `pip install -r requirements.txt`).
pip-install.log

# Ingest-script run logs (regenerated whenever parse / embed is re-run).
parse-run.log
embed-run.log
ingest-run.log

# Streamlit dev-server logs (local-only).
streamlit-stdout.log
streamlit-stderr.log

# Smoke-test scratch outputs (the real artifacts are parsed.json / chunks.json).
data/parsed_smoketest.json
data/chunks_smoketest.json

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# --- Secrets ---
# Streamlit secrets contain the OpenAI key. NEVER commit.
# A redacted template (secrets.toml.example) is committed instead.
.streamlit/secrets.toml

# --- What we DO commit (kept here as a reminder) ---
# data/infosys_ar.pdf          → committed: source-of-truth document
# data/parsed.json             → committed: deterministic parse output, lets reviewers skip re-parsing
# data/chunks.json             → committed: deterministic chunk output, same reason
# chroma_db/                   → committed: the actual vector store. Streamlit Cloud reads it on boot.
